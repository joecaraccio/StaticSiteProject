# Copy to .env and adjust. .env is gitignored; never put secrets in the repo.

# Required by the Docker stack. Dagu and act start sibling containers on the host
# Docker daemon, so their bind mounts need this repo's path *on the host*.
# `make` sets this automatically; set it here if you run `docker compose` directly.
HOST_REPO_PATH=/absolute/path/to/StaticSiteProject

# Ports (host side). Change these if something already uses them.
DASHBOARD_PORT=8000
DAGU_PORT=8080
WEB_PORT=8081
SITE_DEV_PORT=4321
DUCKDB_UI_PORT=4213

# Be polite to BTS: seconds to wait between requests.
DOWNLOAD_DELAY_SECONDS=2.0

# Pin act to a release tag (e.g. v0.2.75) for reproducible local CI.
# Empty means "whatever is latest at image build time".
ACT_VERSION=

# Timezone for Dagu's scheduler.
TZ=UTC
