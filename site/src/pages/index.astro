---
/**
 * Home. The job is one step to the page that answers the question, so the search
 * is the page rather than an ornament on it.
 *
 * Colour here is carrying information, not decorating: every chip is a
 * reliability band from `pipeline/summaries/rules.py`, the same thresholds that
 * phrase the summary sentence. The number is always shown beside it, so nothing
 * depends on distinguishing the hues.
 */
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import ReliabilityChip from "../components/ReliabilityChip.astro";
import { readManifest, readPage, pageTitle, formatPeriod, type PageType } from "../lib/pages";

const manifest = readManifest();

interface Entry {
  url: string;
  title: string;
  type: PageType;
  band: string | null;
  rate: number | null;
  ops: number;
  haystack: string;
}

const entries: Entry[] = [];
if (manifest) {
  for (const item of manifest.pages) {
    const doc = readPage(item);
    entries.push({
      url: item.url,
      title: pageTitle(doc),
      type: item.page_type,
      band: doc.summary?.band ?? null,
      rate: doc.headline_stats.on_time_rate,
      ops: doc.headline_stats.ops_scheduled,
      haystack: [pageTitle(doc), ...Object.values(doc.key)].join(" ").toLowerCase(),
    });
  }
}

const of = (type: PageType) => entries.filter((e) => e.type === type);
const byRate = (list: Entry[]) => [...list].sort((a, b) => (b.rate ?? 0) - (a.rate ?? 0));

const routes = of("route");
const bestRoutes = byRate(routes).slice(0, 6);
const worstRoutes = byRate(routes).reverse().slice(0, 6);
const airports = [...of("airport")].sort((a, b) => b.ops - a.ops);
const airlines = byRate(of("airline"));

// A count per band, so the hero can say something true about the whole dataset
// rather than just how many pages there are.
const bandCounts = routes.reduce<Record<string, number>>((acc, e) => {
  if (e.band) acc[e.band] = (acc[e.band] ?? 0) + 1;
  return acc;
}, {});
const roughRoutes = (bandCounts.serious ?? 0) + (bandCounts.critical ?? 0);
---

<Base
  title="Usually Late — is your flight usually late?"
  description="How reliable each U.S. flight, route, airport and airline has been, from Department of Transportation on-time performance data."
  demoNotice={manifest?.demo_notice ?? null}
  wide={true}
>
  <section class="hero">
    <div class="hero-inner">
      <h1>Is your flight <span class="accent">usually late</span>?</h1>
      <p class="lede">
        Look up any U.S. flight, route, airport or airline and see how often it has actually
        arrived on time — from the Department of Transportation's own records, not an estimate.
      </p>

      {entries.length > 0 && <SearchBox entries={entries} />}

      {
        manifest && (
          <p class="counts">
            <strong>{entries.length.toLocaleString("en-US")}</strong> pages ·
            <strong>{of("flight").length.toLocaleString("en-US")}</strong> flights ·
            <strong>{routes.length}</strong> routes ·
            <strong>{airports.length}</strong> airports ·{" "}
            {formatPeriod(manifest.data_period)}
            {roughRoutes > 0 && (
              <>
                {" "}·{" "}
                <span class="nowrap">
                  <strong>{roughRoutes}</strong> routes often run late
                </span>
              </>
            )}
          </p>
        )
      }
    </div>
  </section>

  {
    !manifest ? (
      <div class="notice">
        <p style="margin-top:0">
          <strong>No pages exported yet.</strong> The site builds from <code>data/export/</code>,
          which the pipeline writes.
        </p>
        <p style="margin-bottom:0">
          Run <code>make verify-source MONTH=2025-01</code>, then{" "}
          <code>make ingest MONTHS=2024-01..2024-12</code>, then <code>make site</code>.
        </p>
      </div>
    ) : (
      <>
        <div class="columns">
          <section>
            <h2><span class="dot dot-good" aria-hidden="true" />Most reliable routes</h2>
            <ul class="cards">
              {bestRoutes.map((e) => (
                <li>
                  <a href={e.url}>
                    <span class="t">{e.title}</span>
                    <ReliabilityChip rate={e.rate} band={e.band} />
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2><span class="dot dot-critical" aria-hidden="true" />Least reliable routes</h2>
            <ul class="cards">
              {worstRoutes.map((e) => (
                <li>
                  <a href={e.url}>
                    <span class="t">{e.title}</span>
                    <ReliabilityChip rate={e.rate} band={e.band} />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        </div>

        <section>
          <h2>Airports</h2>
          <ul class="cards grid">
            {airports.map((e) => (
              <li>
                <a href={e.url}>
                  <span class="t">
                    {e.title}
                    <span class="s">{e.ops.toLocaleString("en-US")} departures</span>
                  </span>
                  <ReliabilityChip rate={e.rate} band={e.band} />
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2>Airlines</h2>
          <ul class="cards grid">
            {airlines.map((e) => (
              <li>
                <a href={e.url}>
                  <span class="t">{e.title}</span>
                  <ReliabilityChip rate={e.rate} band={e.band} />
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="how">
          <h2>How this works</h2>
          <div class="how-grid">
            <div>
              <h3><span class="dot dot-good" aria-hidden="true" />On time means under 15 minutes late</h3>
              <p>
                The Department of Transportation's own threshold, measured on arrival, among
                flights that actually operated.
              </p>
            </div>
            <div>
              <h3><span class="dot dot-serious" aria-hidden="true" />Cancellations count separately</h3>
              <p>
                A cancelled flight is not a late flight — it is a worse outcome, so it never
                quietly improves an on-time rate.
              </p>
            </div>
            <div>
              <h3><span class="dot dot-warning" aria-hidden="true" />Small samples are labelled</h3>
              <p>
                Every figure shows how many flights it is based on, and pages with too little
                history are held back rather than published thin.
              </p>
            </div>
          </div>
        </section>
      </>
    )
  }
</Base>

<style>
  .hero {
    background: linear-gradient(135deg, var(--hero-from), var(--hero-to));
    border: 1px solid var(--hero-edge);
    border-radius: 16px;
    margin: 4px 0 36px;
    padding: 36px 28px 30px;
  }
  .hero-inner { max-width: 660px; }
  .hero h1 {
    font-size: clamp(28px, 5.2vw, 42px);
    line-height: 1.12;
    margin: 0 0 12px;
    letter-spacing: -0.025em;
  }
  .accent {
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--series-1) 30%, transparent) 62%);
    padding: 0 2px;
  }
  .lede { font-size: 17px; color: var(--text-secondary); margin: 0 0 22px; max-width: 56ch; }
  .counts { color: var(--text-muted); font-size: 13px; margin: 18px 0 0; line-height: 1.6; }
  .counts strong { color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .counts .nowrap { white-space: nowrap; }

  .columns { display: grid; gap: 8px 32px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }

  h2 { display: flex; align-items: center; gap: 8px; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; border: 1px solid currentColor; }
  .dot-good { background: var(--band-good-bg); color: var(--band-good-fg); }
  .dot-warning { background: var(--band-warning-bg); color: var(--band-warning-fg); }
  .dot-serious { background: var(--band-serious-bg); color: var(--band-serious-fg); }
  .dot-critical { background: var(--band-critical-bg); color: var(--band-critical-fg); }

  ul.cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 7px; }
  ul.cards.grid { grid-template-columns: repeat(auto-fill, minmax(268px, 1fr)); }
  ul.cards a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 11px 13px;
    text-decoration: none;
    transition: border-color 0.12s, transform 0.12s;
  }
  ul.cards a:hover { border-color: var(--series-1); transform: translateY(-1px); }
  ul.cards .t { color: var(--text-primary); font-weight: 500; display: flex; flex-direction: column; gap: 2px; }
  ul.cards .s { color: var(--text-muted); font-size: 12px; font-weight: 400; }

  .how { margin-top: 44px; }
  .how-grid { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .how h3 { display: flex; align-items: center; gap: 7px; margin: 0 0 6px; font-size: 14.5px; }
  .how p { color: var(--text-secondary); font-size: 14px; margin: 0; }

  @media (max-width: 560px) {
    .hero { padding: 26px 18px 22px; border-radius: 14px; }
  }
</style>
