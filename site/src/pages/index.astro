---
/**
 * Home. The job is to get someone to the page that answers their question in one
 * step, so the search box is the page rather than an ornament on it.
 *
 * The search filters a list rendered at build time. Without JavaScript the full
 * list is still there and still browsable — the script only hides rows.
 */
import Base from "../layouts/Base.astro";
import {
  readManifest,
  readPage,
  pageTitle,
  formatPercent,
  formatPeriod,
  type PageType,
} from "../lib/pages";

const manifest = readManifest();

interface Entry {
  url: string;
  title: string;
  type: PageType;
  onTime: number | null;
  ops: number;
  haystack: string;
}

const entries: Entry[] = [];
if (manifest) {
  for (const item of manifest.pages) {
    const doc = readPage(item);
    entries.push({
      url: item.url,
      title: pageTitle(doc),
      type: item.page_type,
      onTime: doc.headline_stats.on_time_rate,
      ops: doc.headline_stats.ops_scheduled,
      haystack: [pageTitle(doc), ...Object.values(doc.key)].join(" ").toLowerCase(),
    });
  }
}

const routes = entries.filter((e) => e.type === "route");
const airports = entries.filter((e) => e.type === "airport");
const airlines = entries.filter((e) => e.type === "airline");
const flights = entries.filter((e) => e.type === "flight");

const byReliability = [...routes].sort((a, b) => (b.onTime ?? 0) - (a.onTime ?? 0));
const worstRoutes = [...byReliability].reverse().slice(0, 5);
const bestRoutes = byReliability.slice(0, 5);
const busiest = [...airports].sort((a, b) => b.ops - a.ops).slice(0, 6);
---

<Base
  title="Usually Late — is your flight usually late?"
  description="How reliable each U.S. flight, route, airport and airline has been, from Department of Transportation on-time performance data."
  demoNotice={manifest?.demo_notice ?? null}
  compactHeader={false}
>
  <section class="hero">
    <h1>Is your flight usually late?</h1>
    <p class="lede">
      Look up any U.S. flight, route, airport or airline and see how often it has actually arrived
      on time — from the Department of Transportation's own records, not an estimate.
    </p>

    {
      entries.length > 0 && (
        <form class="search" role="search" onsubmit="return false">
          <label class="sr-only" for="q">
            Search flights, routes, airports and airlines
          </label>
          <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
            <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M13.5 13.5L17 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <input
            id="q"
            type="search"
            placeholder="Try a route (BOS ORD), an airport, an airline, or a flight number"
            autocomplete="off"
          />
        </form>
      )
    }
    <p class="counts">
      {
        manifest
          ? `${entries.length.toLocaleString("en-US")} pages · ${flights.length.toLocaleString("en-US")} flights · ${routes.length} routes · ${airports.length} airports · ${formatPeriod(manifest.data_period)}`
          : "No pages exported yet."
      }
    </p>
  </section>

  {
    !manifest ? (
      <div class="notice">
        <p style="margin-top:0">
          <strong>No pages exported yet.</strong> The site builds from <code>data/export/</code>,
          which the pipeline writes.
        </p>
        <p style="margin-bottom:0">
          Run <code>make verify-source MONTH=2025-01</code>, then{" "}
          <code>make ingest MONTHS=2024-01..2024-12</code>, then <code>make site</code>.
        </p>
      </div>
    ) : (
      <>
        <div id="results" hidden>
          <h2>Results</h2>
          <ul class="links" id="results-list" />
          <p class="muted" id="no-results" hidden>
            Nothing matched. Try an airport code like <code>ORD</code>.
          </p>
        </div>

        <div id="browse">
          <section>
            <h2>Most reliable routes</h2>
            <ul class="links">
              {bestRoutes.map((e) => (
                <li>
                  <a href={e.url}>
                    <span class="t">{e.title}</span>
                    <span class="s">{formatPercent(e.onTime, 0)} on time</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>Least reliable routes</h2>
            <ul class="links">
              {worstRoutes.map((e) => (
                <li>
                  <a href={e.url}>
                    <span class="t">{e.title}</span>
                    <span class="s">{formatPercent(e.onTime, 0)} on time</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>Airports</h2>
            <ul class="links">
              {busiest.map((e) => (
                <li>
                  <a href={e.url}>
                    <span class="t">{e.title}</span>
                    <span class="s">
                      {formatPercent(e.onTime, 0)} on time · {e.ops.toLocaleString("en-US")} flights
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2>Airlines</h2>
            <ul class="links">
              {airlines.map((e) => (
                <li>
                  <a href={e.url}>
                    <span class="t">{e.title}</span>
                    <span class="s">{formatPercent(e.onTime, 0)} on time</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="how">
            <h2>How this works</h2>
            <ol>
              <li>
                <strong>On time means under 15 minutes late.</strong> That is the Department of
                Transportation's own threshold, measured on arrival, among flights that actually
                operated.
              </li>
              <li>
                <strong>Cancellations are counted separately.</strong> A cancelled flight is not a
                late flight — it is a worse outcome, so it never quietly improves an on-time rate.
              </li>
              <li>
                <strong>Small samples are labelled, not hidden.</strong> Every figure shows how many
                flights it is based on, and pages with too little history are held back.
              </li>
            </ol>
          </section>
        </div>
      </>
    )
  }
</Base>

<script is:inline define:vars={{ index: entries.map((e) => [e.haystack, e.url, e.title, e.type]) }}>
  const input = document.getElementById("q");
  const results = document.getElementById("results");
  const list = document.getElementById("results-list");
  const empty = document.getElementById("no-results");
  const browse = document.getElementById("browse");

  const LABEL = { flight: "Flight", route: "Route", airport: "Airport", airline: "Airline" };

  function render(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      results.hidden = true;
      browse.hidden = false;
      return;
    }
    // Every whitespace-separated term must appear, so "bos ord" finds the route
    // whichever order it is typed in.
    const terms = q.split(/\s+/);
    const hits = index.filter(([hay]) => terms.every((t) => hay.includes(t))).slice(0, 40);

    list.innerHTML = hits
      .map(
        ([, url, title, type]) =>
          `<li><a href="${url}"><span class="t">${title}</span><span class="s">${LABEL[type]}</span></a></li>`,
      )
      .join("");
    empty.hidden = hits.length > 0;
    results.hidden = false;
    browse.hidden = true;
  }

  input?.addEventListener("input", (event) => render(event.target.value));
</script>

<style>
  .hero { padding: 16px 0 4px; }
  .hero h1 { font-size: clamp(26px, 5.5vw, 38px); line-height: 1.15; margin-bottom: 10px; }
  .lede { font-size: 17px; color: var(--text-secondary); max-width: 58ch; margin: 0 0 20px; }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0 14px;
    max-width: 560px;
    color: var(--text-muted);
  }
  .search:focus-within { border-color: var(--link); color: var(--link); }
  .search input {
    flex: 1;
    border: 0;
    background: transparent;
    padding: 13px 0;
    font: inherit;
    font-size: 15px;
    color: var(--text-primary);
    outline: none;
    min-width: 0;
  }
  .counts { color: var(--text-muted); font-size: 13px; margin: 12px 0 0; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .how ol { max-width: 66ch; padding-left: 20px; color: var(--text-secondary); font-size: 14.5px; }
  .how li { margin-bottom: 10px; }
  .how strong { color: var(--text-primary); }
</style>
