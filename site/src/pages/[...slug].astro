---
/**
 * One template for every page type.
 *
 * getStaticPaths reads the manifest at build time, so the set of pages is exactly
 * what the gates allowed through: a dropped page has no JSON, so it cannot be
 * rendered by accident.
 */
import Base from "../layouts/Base.astro";
import MonthlyChart from "../components/MonthlyChart.astro";
import DelayDistribution from "../components/DelayDistribution.astro";
import DelayCauses from "../components/DelayCauses.astro";
import SourceNote from "../components/SourceNote.astro";
import SummaryBlock from "../components/SummaryBlock.astro";
import ReliabilityChip from "../components/ReliabilityChip.astro";
import AlternativesTable from "../components/AlternativesTable.astro";
import {
  readManifest,
  readPage,
  pageTitle,
  formatPercent,
  formatMinutes,
  formatCount,
  formatPeriod,
  pageExists,
  type PageDocument,
} from "../lib/pages";

export async function getStaticPaths() {
  const manifest = readManifest();
  if (!manifest) return [];
  return manifest.pages.map((entry) => ({
    params: { slug: entry.url.replace(/^\//, "") },
    props: { doc: readPage(entry), demoNotice: manifest.demo_notice },
  }));
}

const { doc, demoNotice } = Astro.props as { doc: PageDocument; demoNotice: string | null };
const stats = doc.headline_stats;
const title = pageTitle(doc);

// Internal links: flight <-> route <-> airport <-> airline (docs/PLAN.md §9).
// Candidates are built from URL patterns, so each one is checked against what
// this build actually serves before it is rendered — the target may have been
// dropped by the gates.
const candidates: { href: string; label: string }[] = [];
const k = doc.key;
if (doc.page_type === "flight") {
  candidates.push({
    href: `/routes/${k.origin}-${k.dest}`,
    label: `All ${k.origin}–${k.dest} flights`,
  });
  candidates.push({ href: `/airlines/${k.carrier}`, label: `${k.carrier} overall` });
  candidates.push({ href: `/airports/${k.origin}`, label: `${k.origin} airport` });
  candidates.push({ href: `/airports/${k.dest}`, label: `${k.dest} airport` });
} else if (doc.page_type === "route") {
  candidates.push({ href: `/airports/${k.origin}`, label: `${k.origin} airport` });
  candidates.push({ href: `/airports/${k.dest}`, label: `${k.dest} airport` });
  candidates.push({ href: `/routes/${k.dest}-${k.origin}`, label: `Return: ${k.dest}–${k.origin}` });
}

const related = candidates.filter((r) => pageExists(r.href));
// Section indexes are ordinary pages that always exist, so they are appended
// after the filter rather than passing through it.
if (doc.page_type === "airline") related.push({ href: "/airlines", label: "All airlines" });
if (doc.page_type === "airport") related.push({ href: "/airports", label: "All airports" });
if (doc.page_type === "route") related.push({ href: "/routes", label: "All routes" });

const description =
  `${title}: ${formatPercent(stats.on_time_rate)} of flights arrived on time across ` +
  `${formatCount(stats.ops_scheduled)} scheduled flights, ${formatPeriod(doc.data_period)}.`;
---

<Base
  title={`${title} — Usually Late`}
  description={description}
  noindex={doc.gate.noindex}
  demoNotice={demoNotice}
>
  <nav class="crumbs">
    <a href="/">Home</a> / <span>{doc.page_type}</span>
  </nav>

  <div class="title-row">
    <h1>{title}</h1>
    <ReliabilityChip rate={stats.on_time_rate} band={doc.summary?.band ?? null} label={true} />
  </div>
  <p class="period">Trailing 12 months of {formatPeriod(doc.data_period)}</p>

  <SummaryBlock summary={doc.summary} />

  {
    doc.gate.noindex && (
      <div class="notice">
        This page is based on a small or dated sample, so treat the figures as indicative.
        {doc.gate.redirect_hint === "route" && doc.page_type === "flight" && (
          <>
            {" "}This flight number has not operated recently — the{" "}
            <a href={`/routes/${k.origin}-${k.dest}`}>{k.origin}–{k.dest} route page</a> is a better
            guide.
          </>
        )}
      </div>
    )
  }

  {/* A handful of headline numbers is a KPI row, not a chart. */}
  <dl class="kpis">
    <div class="kpi">
      <dt>On time</dt>
      <dd>
        {formatPercent(stats.on_time_rate)}
        <span class="sub">of {formatCount(stats.ops_measurable)} measured flights</span>
      </dd>
    </div>
    <div class="kpi">
      <dt>Cancelled</dt>
      <dd>
        {formatPercent(stats.cancellation_rate)}
        <span class="sub">of {formatCount(stats.ops_scheduled)} scheduled</span>
      </dd>
    </div>
    <div class="kpi">
      <dt>When late, by</dt>
      <dd>
        {formatMinutes(stats.avg_arr_delay_when_late_min)}
        <span class="sub">median {formatMinutes(stats.median_arr_delay_when_late_min)}</span>
      </dd>
    </div>
    <div class="kpi">
      <dt>3+ hours late</dt>
      <dd>
        {formatPercent(stats.share_3h_plus)}
        <span class="sub">of flights that operated</span>
      </dd>
    </div>
  </dl>

  <p class="muted">
    On time means arriving less than 15 minutes after the scheduled arrival, among flights that
    operated. Cancellation rate is measured against scheduled flights.
  </p>

  {
    doc.alternatives.length > 0 && (
      <>
        <h2>Should you book a different flight?</h2>
        <AlternativesTable
          alternatives={doc.alternatives}
          origin={String(k.origin)}
          dest={String(k.dest)}
        />
      </>
    )
  }

  <h2>On-time rate by month</h2>
  <MonthlyChart
    series={doc.monthly_series}
    field="on_time_rate"
    title="On-time rate"
    caption="Each point is one month of scheduled service. Hover a point for the sample size."
  />

  <h2>Cancellations by month</h2>
  <MonthlyChart
    series={doc.monthly_series}
    field="cancellation_rate"
    title="Cancellation rate"
    caption="Shown as its own chart: cancellation rates are far smaller than on-time rates, and squeezing both onto one axis would hide the shape of this one."
  />

  <h2>How late, when late</h2>
  <DelayDistribution counts={doc.delay_distribution.counts} shares={doc.delay_distribution.shares} />

  <h2>What caused the delays</h2>
  <DelayCauses
    minutes={doc.delay_causes.minutes}
    shares={doc.delay_causes.shares}
    totalMinutes={doc.delay_causes.total_minutes}
  />

  {
    related.length > 0 && (
      <>
        <h2>Related</h2>
        <ul class="links">
          {related.map((r) => (
            <li>
              <a href={r.href}>
                <span class="t">{r.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <SourceNote
    attribution={doc.source.attribution}
    table={doc.source.table}
    period={doc.data_period}
    generatedAt={doc.generated_at}
  />
</Base>
