---
import Base from "../../layouts/Base.astro";
import IndexList from "../../components/IndexList.astro";
import { readManifest, readPage, pageTitle, formatPeriod } from "../../lib/pages";

const manifest = readManifest();
const rows = (manifest?.pages ?? [])
  .filter((p) => p.page_type === "airline")
  .map((p) => {
    const doc = readPage(p);
    return {
      url: p.url,
      title: pageTitle(doc),
      onTime: doc.headline_stats.on_time_rate,
      band: doc.summary?.band ?? null,
      cancelled: doc.headline_stats.cancellation_rate,
      ops: doc.headline_stats.ops_scheduled,
    };
  })
  .sort((a, b) => (b.onTime ?? 0) - (a.onTime ?? 0));
---

<Base
  title="Airlines — Usually Late"
  description="On-time performance by airline, across every route in the data."
  demoNotice={manifest?.demo_notice ?? null}
>
  <nav class="crumbs"><a href="/">Home</a> / <span>airlines</span></nav>
  <h1>Airlines</h1>
  <p class="period">
    {rows.length.toLocaleString("en-US")} airlines{manifest && `, ${formatPeriod(manifest.data_period)}`}
  </p>
  <p class="muted">On-time performance by airline, across every route in the data.</p>

  {rows.length > 0 ? <IndexList rows={rows} unit="Airline" /> : <p class="notice">Nothing exported yet.</p>}
</Base>
