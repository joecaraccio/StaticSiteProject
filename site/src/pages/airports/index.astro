---
import Base from "../../layouts/Base.astro";
import IndexList from "../../components/IndexList.astro";
import { readManifest, readPage, pageTitle, formatPeriod } from "../../lib/pages";

const manifest = readManifest();
const rows = (manifest?.pages ?? [])
  .filter((p) => p.page_type === "airport")
  .map((p) => {
    const doc = readPage(p);
    return {
      url: p.url,
      title: pageTitle(doc),
      onTime: doc.headline_stats.on_time_rate,
      band: doc.summary?.band ?? null,
      cancelled: doc.headline_stats.cancellation_rate,
      ops: doc.headline_stats.ops_scheduled,
    };
  })
  .sort((a, b) => (b.onTime ?? 0) - (a.onTime ?? 0));
---

<Base
  title="Airports — Usually Late"
  description="Departure reliability at every airport in the data."
  demoNotice={manifest?.demo_notice ?? null}
>
  <nav class="crumbs"><a href="/">Home</a> / <span>airports</span></nav>
  <h1>Airports</h1>
  <p class="period">
    {rows.length.toLocaleString("en-US")} airports{manifest && `, ${formatPeriod(manifest.data_period)}`}
  </p>
  <p class="muted">Departure reliability at every airport in the data.</p>

  {rows.length > 0 ? <IndexList rows={rows} unit="Airport" /> : <p class="notice">Nothing exported yet.</p>}
</Base>
