---
/**
 * Page shell: header, footer, meta, canonical, and the robots rule.
 *
 * A page the gates marked `noindex` gets the meta tag here rather than relying on
 * robots.txt, so the decision travels with the page. A mockup build is always
 * noindexed regardless of what the gates decided.
 */
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DemoBanner from "../components/DemoBanner.astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  demoNotice?: string | null;
  compactHeader?: boolean;
  /** Wider column, for pages that lay out in more than one column. */
  wide?: boolean;
}

const {
  title,
  description,
  noindex = false,
  demoNotice = null,
  compactHeader = false,
  wide = false,
} = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:8081");
// Colour scheme, chosen at build time. See the header of public/styles/global.css.
const theme = process.env.SITE_THEME ?? "ocean";
// Synthetic pages must never be indexed, whatever the gates said.
const blockIndexing = noindex || Boolean(demoNotice);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    {blockIndexing && <meta name="robots" content="noindex, follow" />}
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    {demoNotice && <DemoBanner notice={demoNotice} />}
    <SiteHeader compact={compactHeader} />
    <main class={wide ? "wrap wide" : "wrap"}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
