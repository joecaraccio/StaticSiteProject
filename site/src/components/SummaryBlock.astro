---
/**
 * The rule-based summary.
 *
 * Every sentence here came from `pipeline/summaries/rules.py`. Nothing is
 * generated at build time and nothing is written by a language model — the same
 * numbers always produce the same words, which is what makes the text testable.
 */
interface Props {
  summary: { sentences: string[]; matched_rules: string[] } | null;
}
const { summary } = Astro.props as Props;
const sentences = summary?.sentences ?? [];
---

{
  sentences.length > 0 && (
    <div class="summary">
      <p class="lead">{sentences[0]}</p>
      {sentences.length > 1 && (
        <ul>
          {sentences.slice(1).map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      )}
    </div>
  )
}

<style>
  .summary {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    margin: 20px 0 8px;
  }
  .lead {
    margin: 0;
    font-size: 17px;
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: -0.008em;
    max-width: 62ch;
  }
  ul {
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--text-secondary);
    font-size: 14.5px;
    max-width: 66ch;
  }
  li { margin-bottom: 4px; }
  li:last-child { margin-bottom: 0; }
</style>
