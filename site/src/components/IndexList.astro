---
/**
 * A section index: every page of one type, sortable columns rendered at build
 * time. Shared by /routes, /airports and /airlines so the three cannot drift.
 */
import { formatPercent } from "../lib/pages";

interface Row {
  url: string;
  title: string;
  onTime: number | null;
  cancelled: number | null;
  ops: number;
}

interface Props {
  rows: Row[];
  unit: string;
}

const { rows, unit } = Astro.props as Props;
const best = Math.max(...rows.map((r) => r.onTime ?? 0), 0.0001);
---

<table>
  <thead>
    <tr>
      <th>{unit}</th>
      <th>On time</th>
      <th class="num">Cancelled</th>
      <th class="num">Flights</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <td>
            <a href={r.url}>{r.title}</a>
          </td>
          <td>
            <span class="rate">
              <svg
                viewBox="0 0 100 10"
                preserveAspectRatio="none"
                role="img"
                aria-label={`${formatPercent(r.onTime, 0)} on time`}
                style="width:80px;height:10px"
              >
                <rect x="0" y="0" width="100" height="10" rx="4" fill="var(--grid)" />
                <rect
                  x="0"
                  y="0"
                  width={Math.max(2, ((r.onTime ?? 0) / best) * 100)}
                  height="10"
                  rx="4"
                  fill="var(--series-1)"
                />
              </svg>
              <strong>{formatPercent(r.onTime, 0)}</strong>
            </span>
          </td>
          <td class="num">{formatPercent(r.cancelled, 1)}</td>
          <td class="num">{r.ops.toLocaleString("en-US")}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .rate { display: flex; align-items: center; gap: 9px; }
  .rate strong { font-variant-numeric: tabular-nums; min-width: 34px; }
  @media (max-width: 560px) {
    th:nth-child(3), td:nth-child(3) { display: none; }
    .rate svg { width: 44px !important; }
  }
</style>
