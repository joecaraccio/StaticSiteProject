---
/**
 * The homepage search: a large input with an autocomplete listbox.
 *
 * Progressive enhancement. The index is embedded at build time and the whole
 * browsable list is rendered below, so with JavaScript off the page is still a
 * complete directory — the script only adds the dropdown.
 *
 * Follows the ARIA combobox pattern: the input owns the listbox, announces
 * expansion, and points at the active option, so arrow keys work for everyone
 * rather than only for people using a mouse.
 *
 * Submitting (the Search button, or Enter with no option highlighted) is a plain
 * GET to /search?q=…, the full results page. Enter on a highlighted option still
 * goes straight to that page.
 */
import type { SearchEntry } from "../lib/pages";
import type { IndexRow } from "../lib/search";

interface Props {
  entries: SearchEntry[];
  placeholder?: string;
  /** Off on /search, where the results list below does the dropdown's job. */
  dropdown?: boolean;
}

const {
  entries,
  placeholder = "Search a route, airport, airline or flight number",
  dropdown = true,
} = Astro.props as Props;

const index: IndexRow[] = entries.map((e) => [
  e.haystack,
  e.url,
  e.title,
  e.type,
  e.band ?? "",
  e.rate ?? -1,
  e.ops,
]);
// Inside a <script> element "</" would end it early, so escape "<" in the JSON.
const indexJson = JSON.stringify(index).replace(/</g, "\\u003c");
---

<script type="application/json" id="search-index" set:html={indexJson} />

<div class="search-shell" data-dropdown={dropdown ? "on" : "off"}>
  <form class="search" role="search" autocomplete="off" action="/search" method="get">
    <label class="sr-only" for="q">Search flights, routes, airports and airlines</label>
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
      <circle cx="9" cy="9" r="6.25" fill="none" stroke="currentColor" stroke-width="1.9" />
      <path d="M13.7 13.7L17.5 17.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
    </svg>
    <input
      id="q"
      name="q"
      type="text"
      enterkeyhint="search"
      role="combobox"
      placeholder={placeholder}
      aria-expanded="false"
      aria-controls="ac-list"
      aria-autocomplete="list"
      aria-haspopup="listbox"
    />
    <button type="button" id="q-clear" aria-label="Clear search" hidden>
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <button type="submit" class="search-go">Search</button>
  </form>
  <ul id="ac-list" role="listbox" aria-label="Search results" hidden></ul>
  <p class="hint" id="q-hint">
    Try <button type="button" class="chip-btn" data-q="ORD">ORD</button>
    <button type="button" class="chip-btn" data-q="BOS ORD">BOS ORD</button>
    <button type="button" class="chip-btn" data-q="DL">DL</button>
  </p>
</div>

<script>
  import { match, readIndex, escapeHtml, TYPE_LABEL, BAND_LABEL, type IndexRow } from "../lib/search";

  const shell = document.querySelector<HTMLElement>(".search-shell");
  const form = shell?.querySelector<HTMLFormElement>("form");
  const input = document.getElementById("q") as HTMLInputElement | null;
  const list = document.getElementById("ac-list") as HTMLUListElement | null;
  const clear = document.getElementById("q-clear") as HTMLButtonElement | null;

  if (shell && form && input && list && clear) {
    const index = readIndex();
    const dropdown = shell.dataset.dropdown !== "off";
    const MAX = 8;

    let matches: IndexRow[] = [];
    let active = -1;

    const render = () => {
      if (matches.length === 0) {
        list.hidden = true;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        return;
      }
      list.innerHTML = matches
        .map(([, url, title, type, band, rate], i) => {
          const pct = rate >= 0 ? `${Math.round(rate * 100)}%` : "—";
          const cls = band ? `band-${band}` : "band-unknown";
          const words = band ? BAND_LABEL[band] : "not enough data";
          return `<li role="option" id="ac-${i}" aria-selected="${i === active}" data-url="${escapeHtml(url)}">
            <a href="${escapeHtml(url)}" tabindex="-1">
              <span class="ac-main">
                <span class="ac-title">${escapeHtml(title)}</span>
                <span class="ac-type">${TYPE_LABEL[type] ?? type}</span>
              </span>
              <span class="band ${cls}"><span>${pct}</span><span class="band-label">${words}</span></span>
            </a></li>`;
        })
        .join("");
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
      if (active >= 0) input.setAttribute("aria-activedescendant", `ac-${active}`);
      else input.removeAttribute("aria-activedescendant");
    };

    const move = (delta: number) => {
      if (matches.length === 0) return;
      active = (active + delta + matches.length) % matches.length;
      render();
      list.children[active]?.scrollIntoView({ block: "nearest" });
    };

    const close = () => { matches = []; active = -1; render(); };

    const update = (value: string) => {
      matches = dropdown ? match(index, value).slice(0, MAX) : [];
      active = -1;
      clear.hidden = value.length === 0;
      render();
    };

    // On /search the query arrives in the URL; show it in the box.
    const q = new URLSearchParams(window.location.search).get("q");
    if (q && !input.value) input.value = q;
    clear.hidden = input.value.length === 0;

    input.addEventListener("input", () => update(input.value));

    input.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown": event.preventDefault(); move(1); break;
        case "ArrowUp": event.preventDefault(); move(-1); break;
        case "Enter":
          // A highlighted option is a choice; otherwise Enter submits to /search.
          if (active >= 0 && matches[active]) {
            event.preventDefault();
            window.location.href = matches[active][1];
          }
          break;
        case "Escape":
          if (!list.hidden) close();
          else { input.value = ""; input.dispatchEvent(new Event("input")); }
          break;
      }
    });

    // An empty search has nowhere useful to go.
    form.addEventListener("submit", (event) => {
      if (input.value.trim() === "") { event.preventDefault(); input.focus(); }
    });

    list.addEventListener("mousemove", (event) => {
      const item = (event.target as Element).closest("li[role=option]");
      if (!item) return;
      const next = [...list.children].indexOf(item);
      if (next !== active) { active = next; render(); }
    });

    clear.addEventListener("click", () => {
      input.value = "";
      input.dispatchEvent(new Event("input"));
      input.focus();
    });

    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest(".search-shell")) close();
    });

    // Dispatch rather than calling update(), so /search hears the change too.
    for (const button of shell.querySelectorAll<HTMLButtonElement>(".chip-btn")) {
      button.addEventListener("click", () => {
        input.value = button.dataset.q ?? "";
        input.focus();
        input.dispatchEvent(new Event("input"));
      });
    }

    // "/" focuses search, the way most search-first sites behave.
    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== input) {
        event.preventDefault();
        input.focus();
      }
    });
  }
</script>

<style is:global>
  /* Global, not scoped: the listbox items are built by the inline script with
     innerHTML, so they never get Astro's scoping attribute and scoped rules
     would not reach them. Every selector here is under .search-shell or
     #ac-list, both unique to this component. */
  .search-shell { position: relative; }

  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface-sunken);
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0 16px;
    color: var(--text-muted);
    transition: border-color 0.12s, box-shadow 0.12s;
  }
  .search:focus-within {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--surface);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 17px 0;
    font: inherit;
    font-size: 17px;
    color: var(--text-primary);
    outline: none;
  }
  .search button {
    border: 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    display: flex;
    border-radius: 6px;
  }
  .search button:hover { color: var(--text-primary); background: var(--border); }
  .search .search-go {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    background: var(--primary);
    padding: 10px 20px;
    margin-right: -8px;
    border-radius: var(--radius-sm);
  }
  .search .search-go:hover { color: #fff; background: var(--primary-hover); }

  #ac-list {
    position: absolute;
    z-index: 40;
    left: 0;
    right: 0;
    margin: 6px 0 0;
    padding: 5px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-2);
    max-height: 60vh;
    overflow-y: auto;
  }
  #ac-list li { list-style: none; }
  #ac-list a {
    display: flex;
    text-decoration: none;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 11px;
    border-radius: 8px;
    color: inherit;
  }
  #ac-list a:hover { text-decoration: none; }
  #ac-list li[aria-selected="true"] a { background: var(--primary-soft); }
  .ac-main { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .ac-title { color: var(--text-primary); font-weight: 500; }
  .ac-type {
    color: var(--text-muted);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hint { color: var(--text-muted); font-size: 13px; margin: 12px 0 0; }
  .chip-btn {
    font: inherit;
    font-size: 12.5px;
    font-weight: 500;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-secondary);
    border-radius: var(--radius-pill);
    padding: 4px 12px;
    margin-right: 4px;
    cursor: pointer;
  }
  .chip-btn:hover { border-color: var(--primary); color: var(--primary); background: var(--primary-soft); }

  @media (max-width: 520px) {
    .search input { font-size: 16px; padding: 15px 0; }
    .search .search-go { padding: 9px 14px; }
    #ac-list a { flex-direction: column; align-items: flex-start; gap: 5px; }
  }
</style>
