---
/**
 * Shown on every page of a mockup build, and on no page of a real one.
 *
 * The pipeline stamps `demo_notice` onto each document only when `export` was
 * given `--demo-notice`, which only scripts/make_mockup_data.py does. Pages
 * carrying it are also forced to noindex by the layout.
 */
interface Props {
  notice: string;
}
const { notice } = Astro.props as Props;
---

<div class="demo-banner" role="note">
  <strong>Synthetic data</strong>
  <span>{notice}</span>
</div>

<style>
  .demo-banner {
    background: var(--demo-bg);
    color: var(--demo-text);
    border-bottom: 1px solid var(--demo-border);
    padding: 9px 16px;
    font-size: 13px;
    line-height: 1.45;
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    text-align: center;
  }
  .demo-banner strong {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11.5px;
    align-self: center;
  }
</style>
