---
/**
 * Navy chrome bar. Sticky, because on a long results page the way back to
 * search should never be a scroll away.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props as Props;
const nav = [
  { href: "/routes", label: "Routes" },
  { href: "/airports", label: "Airports" },
  { href: "/airlines", label: "Airlines" },
  { href: "/connections", label: "Connections" },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="inner">
    <a class="wordmark" href="/">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        <circle cx="11" cy="11" r="9.2" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M11 5.6V11l3.4 2.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span>Usually&nbsp;Late</span>
    </a>
    {
      !compact && (
        <nav aria-label="Sections">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</header>

<style>
  .site-header {
    background: var(--brand);
    color: var(--brand-ink);
    position: sticky;
    top: 0;
    z-index: 30;
  }
  .inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 16px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 16.5px;
    letter-spacing: -0.02em;
    color: var(--brand-ink);
    text-decoration: none;
  }
  nav { display: flex; gap: 2px; flex-wrap: wrap; }
  nav a {
    color: var(--brand-dim);
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    padding: 7px 12px;
    border-radius: var(--radius-sm);
  }
  nav a:hover { background: rgb(255 255 255 / 0.12); color: var(--brand-ink); }
  nav a[aria-current="page"] { color: var(--brand-ink); font-weight: 650; }
  @media (max-width: 560px) {
    .inner { height: auto; padding: 10px 16px; flex-direction: column; align-items: flex-start; gap: 8px; }
    nav a { padding: 5px 9px; font-size: 14px; }
  }
</style>
