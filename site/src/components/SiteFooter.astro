---
import Logo from "./Logo.astro";
/** Site-wide footer. The per-page source credit is SourceNote.astro. */
---

<footer class="site-footer">
  <div class="inner">
    <p class="brand"><Logo size={19} /><span>Usually Late</span></p>
    <p>Historical U.S. flight reliability, built from public Department of Transportation records.</p>
    <p class="fine">
      Source: U.S. Department of Transportation, Bureau of Transportation Statistics, Airline
      On-Time Performance. Figures describe how flights have behaved in the past; they are not
      predictions and not affiliated with any airline.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand);
    color: var(--brand-dim);
    margin-top: 52px;
  }
  .inner { max-width: 1040px; margin: 0 auto; padding: 28px 16px 36px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--brand-ink);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  p { margin: 0 0 8px; font-size: 13.5px; max-width: 72ch; }
  .fine { opacity: 0.78; font-size: 12.5px; margin: 0; }
</style>
