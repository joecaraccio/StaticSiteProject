---
import Logo from "./Logo.astro";
import { readManifest, formatPeriod } from "../lib/pages";

/**
 * Site-wide footer.
 *
 * Carries the source credit and the data period, which CLAUDE.md requires on
 * every page. Detail pages state their own period again near the figures, where
 * it is doing real work; here it is the backstop that covers the homepage and
 * the connection checker.
 */
const manifest = readManifest();
const period = manifest ? formatPeriod(manifest.data_period) : null;
---

<footer class="site-footer">
  <div class="inner">
    <p class="brand"><Logo size={19} /><span>Usually Late</span></p>
    <p>Historical U.S. flight reliability, built from public Department of Transportation records.</p>
    <p class="fine">
      Source: U.S. Department of Transportation, Bureau of Transportation Statistics, Airline
      On-Time Performance{period ? `, ${period}` : ""}. Figures describe how flights have behaved
      in the past; they are not predictions and not affiliated with any airline.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand);
    color: var(--brand-dim);
    margin-top: 52px;
  }
  .inner { max-width: 1040px; margin: 0 auto; padding: 28px 16px 36px; }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--brand-ink);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  p { margin: 0 0 8px; font-size: 13.5px; max-width: 72ch; }
  .fine { opacity: 0.78; font-size: 12.5px; margin: 0; }
</style>
